# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Cython build files
*.c
*.cpp
*.so
*.pyd
build/
dist/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Matplotlib or other image outputs
*.png
*.jpg
*.jpeg
*.gif
*.svg

# Do not ignore images if they are under:
!documentation/source/_static/figs/*.png
!documentation/source/_static/figs/*.jpg
!documentation/source/_static/figs/*.jpeg
!documentation/source/_static/figs/*.gif

# MacOS metadata
.DS_Store

# VS Code workspace files
.vscode/

# Output from Matlab
